{
  "$schema": "enterprise-design-system/v1",
  "version": "1.0.0",
  "meta": {
    "name": "Enterprise Design System",
    "description": "Unified visual language for multi-product SaaS platform",
    "fontPrimary": "Inter",
    "fontMono": "JetBrains Mono",
    "iconLibrary": "Lucide",
    "baseFontSize": "16px",
    "baseSpacingUnit": "4px"
  },
  "color": {
    "primary": {
      "50": "#EFF6FF",
      "100": "#DBEAFE",
      "200": "#BFDBFE",
      "300": "#93C5FD",
      "400": "#60A5FA",
      "500": "#3B82F6",
      "600": "#2563EB",
      "700": "#1D4ED8",
      "800": "#1E40AF",
      "900": "#1E3A8A"
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F8FAFC",
      "100": "#F1F5F9",
      "200": "#E2E8F0",
      "300": "#CBD5E1",
      "400": "#94A3B8",
      "500": "#64748B",
      "600": "#475569",
      "700": "#334155",
      "800": "#1E293B",
      "900": "#0F172A",
      "950": "#020617"
    },
    "semantic": {
      "success": { "bg": "#ECFDF5", "fg": "#047857", "border": "#6EE7B7", "icon": "#059669" },
      "warning": { "bg": "#FFFBEB", "fg": "#B45309", "border": "#FCD34D", "icon": "#D97706" },
      "error": { "bg": "#FEF2F2", "fg": "#B91C1C", "border": "#FCA5A5", "icon": "#DC2626" },
      "info": { "bg": "#EFF6FF", "fg": "#1D4ED8", "border": "#93C5FD", "icon": "#2563EB" }
    },
    "product": {
      "churchhub": "#6366F1",
      "microfinance": "#0D9488",
      "erp": "#2563EB",
      "school": "#7C3AED",
      "hospital": "#0891B2",
      "hr": "#EA580C"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"],
      "mono": ["JetBrains Mono", "ui-monospace", "Consolas", "monospace"]
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "display-xl": { "size": "3.75rem", "lineHeight": 1.1, "weight": 700, "letterSpacing": "-0.02em" },
      "display-lg": { "size": "3rem", "lineHeight": 1.15, "weight": 700, "letterSpacing": "-0.02em" },
      "display-md": { "size": "2.25rem", "lineHeight": 1.2, "weight": 700, "letterSpacing": "-0.015em" },
      "heading-xl": { "size": "1.875rem", "lineHeight": 1.25, "weight": 600, "letterSpacing": "-0.01em" },
      "heading-lg": { "size": "1.5rem", "lineHeight": 1.3, "weight": 600, "letterSpacing": "-0.01em" },
      "heading-md": { "size": "1.25rem", "lineHeight": 1.4, "weight": 600, "letterSpacing": "0" },
      "heading-sm": { "size": "1.125rem", "lineHeight": 1.4, "weight": 600, "letterSpacing": "0" },
      "body-lg": { "size": "1.125rem", "lineHeight": 1.6, "weight": 400, "letterSpacing": "0" },
      "body-md": { "size": "1rem", "lineHeight": 1.6, "weight": 400, "letterSpacing": "0" },
      "body-sm": { "size": "0.875rem", "lineHeight": 1.5, "weight": 400, "letterSpacing": "0" },
      "caption": { "size": "0.75rem", "lineHeight": 1.4, "weight": 400, "letterSpacing": "0.01em" },
      "overline": { "size": "0.6875rem", "lineHeight": 1.3, "weight": 600, "letterSpacing": "0.08em", "textTransform": "uppercase" }
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },
  "radius": {
    "none": "0",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "2xl": "16px",
    "full": "9999px"
  },
  "shadow": {
    "xs": "0 1px 2px rgba(15, 23, 42, 0.05)",
    "sm": "0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04)",
    "md": "0 4px 6px -1px rgba(15, 23, 42, 0.08), 0 2px 4px -2px rgba(15, 23, 42, 0.04)",
    "lg": "0 10px 15px -3px rgba(15, 23, 42, 0.08), 0 4px 6px -4px rgba(15, 23, 42, 0.04)",
    "xl": "0 20px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04)"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "layout": {
    "maxWidth": "1280px",
    "maxWidthWide": "1440px",
    "proseWidth": "720px",
    "gutter": "24px",
    "headerHeight": "72px",
    "headerHeightMobile": "64px",
    "sidebarWidth": "260px",
    "sidebarCollapsed": "64px"
  },
  "icon": {
    "xs": "14px",
    "sm": "16px",
    "md": "20px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "strokeWidth": 1.5
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "100ms",
      "normal": "200ms",
      "slow": "300ms",
      "slower": "500ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "out": "cubic-bezier(0, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "zIndex": {
    "base": 0,
    "dropdown": 100,
    "sticky": 200,
    "sidebar": 250,
    "overlay": 300,
    "modal": 400,
    "toast": 500,
    "tooltip": 600
  },
  "components": {
    "button": {
      "sizes": {
        "xs": { "height": "28px", "paddingX": "10px", "fontSize": "12px", "iconSize": "14px" },
        "sm": { "height": "32px", "paddingX": "12px", "fontSize": "14px", "iconSize": "16px" },
        "md": { "height": "40px", "paddingX": "16px", "fontSize": "14px", "iconSize": "18px" },
        "lg": { "height": "48px", "paddingX": "20px", "fontSize": "16px", "iconSize": "20px" },
        "xl": { "height": "56px", "paddingX": "24px", "fontSize": "16px", "iconSize": "22px" }
      },
      "variants": ["primary", "secondary", "tertiary", "destructive", "destructive-outline", "link"]
    },
    "input": {
      "sizes": {
        "sm": { "height": "32px", "padding": "8px 12px", "fontSize": "14px" },
        "md": { "height": "40px", "padding": "10px 14px", "fontSize": "14px" },
        "lg": { "height": "48px", "padding": "12px 16px", "fontSize": "16px" }
      }
    },
    "card": {
      "variants": ["default", "flat", "elevated", "interactive", "stat"],
      "padding": { "sm": "16px", "md": "24px", "lg": "32px" }
    },
    "alert": {
      "variants": ["info", "success", "warning", "error"],
      "placements": ["inline", "banner", "toast", "system"]
    },
    "table": {
      "variants": ["default", "compact", "comfortable", "striped", "borderless"],
      "rowHeight": { "default": "48px", "compact": "40px" },
      "headerHeight": "44px"
    },
    "navigation": {
      "headerHeight": "72px",
      "variants": ["public", "portal", "admin"],
      "tabs": ["underline", "pill", "bordered"]
    },
    "sidebar": {
      "width": "260px",
      "collapsedWidth": "64px",
      "itemHeight": "40px"
    },
    "hero": {
      "variants": ["centered", "split-50-50", "split-40-60", "background-image", "minimal"],
      "paddingY": { "desktop": "96px", "mobile": "48px" }
    }
  },
  "accessibility": {
    "wcagTarget": "2.1 AA",
    "minContrastBody": "4.5:1",
    "minContrastLarge": "3:1",
    "minTouchTarget": "44px",
    "focusRingWidth": "2px",
    "focusRingOffset": "2px"
  },
  "theme": {
    "default": "light",
    "modes": ["light", "dark", "system"],
    "attribute": "data-theme"
  }
}
