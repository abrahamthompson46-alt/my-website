[Unit]
Description=Zreta scheduled backup (database + media)
Documentation=file:/var/www/marketing-site/docs/ZRETA_BACKUP_POLICY.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=APP_DIR=/var/www/marketing-site
Environment=BACKUP_ROOT=/var/backups/zreta
WorkingDirectory=/var/www/marketing-site
ExecStart=/bin/bash /var/www/marketing-site/deploy/scripts/backup-all.sh
Nice=10
IOSchedulingClass=best-effort
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
