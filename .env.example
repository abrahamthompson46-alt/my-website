# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — SQLite for local development (default)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# PostgreSQL (production / staging / optional local dev)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=enterprise_platform
# DB_USER=postgres
# DB_PASSWORD=your-postgres-password
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=600

# URLs
SITE_URL=http://localhost:8000
SITE_NAME=Enterprise Platform
SITE_DESCRIPTION=Enterprise software platform for modern teams — products, documentation, and customer success.
SITE_DEFAULT_TITLE=Enterprise Platform
SEO_TWITTER_HANDLE=
SEO_SOCIAL_PROFILES=
SEO_DEFAULT_OG_IMAGE=/static/images/og-default.svg

# Email (development defaults)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Static & Media
STATIC_URL=/static/
MEDIA_URL=/media/

# Payment gateways (set enabled=true and add keys to activate)
PAYMENTS_DEFAULT_GATEWAY=manual
MANUAL_PAYMENTS_ENABLED=True
# PAYMENTS_DEFAULT_GATEWAY=paystack
# PAYSTACK_ENABLED=True
# PAYSTACK_PUBLIC_KEY=pk_test_xxx
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_WEBHOOK_SECRET=whsec_xxx
# HUBTEL_ENABLED=False
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# HUBTEL_MERCHANT_ACCOUNT=
# HUBTEL_WEBHOOK_SECRET=
# FLUTTERWAVE_ENABLED=False
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_SECRET=

# Security (production)
# See .env.production.example for full production configuration.
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# SECURE_SSL_REDIRECT=True

# Redis (recommended — shared cache, sessions, and rate limits)
# With docker compose: REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Media storage (optional — S3 in production)
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
